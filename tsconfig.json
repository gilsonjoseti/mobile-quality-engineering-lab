{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@appium/*": ["./appium/*"],
      "@api/*": ["./api/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    "coverage"
  ]
}
